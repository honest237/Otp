{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    { "type": "TextBlock", "text": "Digisms Pro", "weight": "Bolder", "size": "Medium", "color": "Accent" },
    {
      "type": "Container",
      "$data": "${items}",
      "spacing": "Medium",
      "selectAction": { "type": "Action.OpenUrl", "url": "${url}" },
      "items": [
        { "type": "TextBlock", "text": "${title}", "weight": "Bolder", "wrap": true, "maxLines": 2 },
        { "type": "TextBlock", "text": "${text}", "wrap": true, "isSubtle": true, "size": "Small", "maxLines": 3 }
      ]
    },
    { "type": "TextBlock", "text": "No updates yet. Check back soon.", "isVisible": "${empty}", "isSubtle": true, "wrap": true }
  ],
  "actions": [{ "type": "Action.OpenUrl", "title": "Open updates", "url": "${openUrl}" }]
}
