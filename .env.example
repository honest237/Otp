# Digisms Pro — copy to .env for local development.
# Never commit a populated .env. Use Vercel Environment Variables in production.

# Explicitly choose demo or live. Demo uses fictional numbers and sandbox credits.
# Vercel defaults to live (fail-closed) if APP_MODE is missing.
APP_MODE=demo

# Local PostgreSQL (already provided in the development sandbox).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# For Supabase + Vercel: use the Supabase transaction-pooler connection on port 6543.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Use the direct or session-pooler (5432) connection for migrations, NOT the transaction pooler.
DIRECT_DATABASE_URL=

# Initial administrator. Open /admin directly and log in with these to create the first admin.
# Public/customer accounts never receive administrator permission, including in demo mode.
# Set a unique password of at least 12 characters. No hardcoded default is shipped.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# NumberOTP's documented API base. Secrets are only read by server-side routes.
NUMBEROTP_BASE_URL=https://api.numberotp.com/v1
NUMBEROTP_API_KEY=
# Match these secrets to NumberOTP Developer > Global Webhook and reseller settings.
# Both webhook URLs: https://YOUR_DOMAIN/api/webhooks/numberotp
NUMBEROTP_WEBHOOK_SECRET=
NUMBEROTP_RESELLER_WEBHOOK_SECRET=
# Only needed for the admin console's sub-user-hosted card / crypto checkout operations.
# This is a SUB-USER key, not the reseller's account API key.
NUMBEROTP_SUBUSER_API_KEY=
# UI countdown fallback when the provider omits expires_at / expiresAt.
# Actual refunds depend on provider-confirmed terminal status, never this timer alone.
NUMBEROTP_ACTIVATION_MINUTES=20

# Ashtech Pay DIRECT API (not the hp_live_ Hosted Checkout key).
# KYC and Direct API access must be enabled in the Ashtech Pay dashboard.
ASHTECH_API_KEY=
ASHTECH_USER_ID=
ASHTECH_BASE_URL=https://www.ashtechpay.com/v1
# From Ashtech Pay: API Key > Direct API > Webhook Secret (whsec_...).
ASHTECH_WEBHOOK_SECRET=
# Your public HTTPS app origin; never derive payment callbacks from browser input.
# Ashtech callback: https://YOUR_DOMAIN/api/webhooks/ashtechpay
APP_URL=
# Optional merchant-defined exchange rates: units of currency per 1 USD, as JSON.
# If omitted, live rates use the cached ExchangeRate-API endpoint with attribution.
# Example only (set your own current rates): {"XAF":600,"XOF":600}
STORE_FX_RATES=
# Existing users keep their original USD balances. New signup countries use
# GET /v1/countries. Other is always USD. Demo rates are clearly labeled samples.

# Supabase database hosting works through DATABASE_URL; no client DB access is required.
# These are needed only for admin uploads and private customer downloads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Create product-assets (public), product-deliveries (private), and news-media (private).
# Apply supabase/upgrade-media-uploads.sql (existing installations) or the fresh schema.
# Large APK/video files upload directly to Storage, not through Vercel functions.
# Set your Supabase project-wide file limit to match your plan and desired upload sizes.

# Optional Vercel cron protection for scheduled reconciliation / session cleanup.
CRON_SECRET=

# Digi AI assistant (shopping help + support) powered by Groq. Leave GROQ_API_KEY empty to switch the assistant off.
# Create a key at https://console.groq.com/keys and add it as a server-side environment variable only.
GROQ_API_KEY=
# Optional model overrides. Groq retires models often, so check https://console.groq.com/docs/deprecations
# GROQ_MODEL=openai/gpt-oss-120b        # chat + tool calling
# GROQ_VISION_MODEL=qwen/qwen3.8-27b    # used only when a customer sends a screenshot

# Boost (social media growth / SMM). Customers only ever see "SMM v1" and "SMM v2".
# v1 = ExoSupplier, v2 = Peakerr. Keys are read by server routes only; never expose them to the browser.
# URLs default to each panel's standard API endpoint; override only if your provider gives you a different one.
SMM_V1_API_URL=https://exosupplier.com/api/v2
SMM_V1_API_KEY=
SMM_V2_API_URL=https://peakerr.com/api/v2
SMM_V2_API_KEY=
# Boost markup (percent added to provider rates) is set in Admin > Pricing & margins.

# Web push (live notifications when the app is closed). Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# ── Temp mail (/mail) ──────────────────────────────────────────────────────────
# Which mailbox versions customers can choose. v1 = GrabMail, v2 = smails, v3 = MailboxTemp, v4 = mail.tm, v5 = NenzMail.
# v4 is off by default: mail.tm's terms require visible attribution and forbid proxying/reselling — read them before enabling.
TEMPMAIL_PROVIDERS=v1,v2,v3
# Server-side only. Never expose this in client code or commit it.
GRABMAIL_API_KEY=
# Set to 1 to open new Mail V1 addresses on GrabMail's premium domain pool (needs a paid GrabMail plan; each new address uses allowance).
GRABMAIL_USE_PREMIUM=
